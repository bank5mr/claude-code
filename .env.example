# ── Supabase ──────────────────────────────────────────────
# 대시보드 > Project Settings > API Keys (또는 Connect 버튼)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# 브라우저에 노출돼도 되는 키 (sb_publishable_...). RLS가 허용한 것만 읽힌다
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 서버 전용 (sb_secret_...). RLS를 우회하므로 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SECRET_KEY=sb_secret_...

# ── 토스페이먼츠 (주문서형 결제 연동 키) ─────────────────────
# 개발자센터 > API 키 > 결제위젯(주문서형·결제창형) 연동 키
# 아래는 토스 문서에 공개된 테스트 키. 계약 후엔 내 상점 키로 교체
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
# 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6
