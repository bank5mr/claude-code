# ── Supabase ──────────────────────────────────────────────
# 대시보드 > Project Settings > API Keys (또는 Connect 버튼)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# 브라우저에 노출돼도 되는 키 (sb_publishable_...). RLS가 허용한 것만 읽힌다
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 서버 전용 (sb_secret_...). RLS를 우회하므로 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SECRET_KEY=sb_secret_...
